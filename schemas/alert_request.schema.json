{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.local/schemas/alert_request.schema.json",
  "title": "AlertRequest",
  "description": "ThreatWatch POST /alerts 요청 계약의 로컬 사본. 원본 기준은 ThreatWatch 게이트웨이의 JSON Schema 모델이며, 어긋나면 이 파일을 원본에 맞춰 갱신할 것 (랩장 확인 사항).",
  "type": "object",
  "required": ["incident_type", "severity"],
  "additionalProperties": false,
  "properties": {
    "incident_type": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "게이트웨이 enum 기준 — 실제 허용 값은 랩장이 확인"
    },
    "alert_id": { "type": "string" },
    "timestamp": { "type": "string" },
    "asset_criticality": { "type": "string", "enum": ["low", "medium", "high"] },
    "pii_flag": { "type": "boolean" },
    "user_role": { "type": "string" },
    "indicators": { "type": "array", "items": { "type": "string" } },
    "description": { "type": "string" }
  }
}
